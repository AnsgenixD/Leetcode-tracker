{
  "manifest_version": 3,
  "name": "LeetEdge Tracker",
  "version": "1.0",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "*://leetcode.com/*",
    "*://localhost/*",
    "*://leetcode-tracker-steel.vercel.app/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "leetedge@tracker",
      "strict_min_version": "101.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://leetcode.com/problems/*"],
      "js": ["content-leetcode.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "https://leetcode-tracker-steel.vercel.app/*"
      ],
      "js": ["content-dashboard.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
